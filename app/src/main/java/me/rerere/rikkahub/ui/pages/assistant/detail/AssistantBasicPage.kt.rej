- */
-private const val MIN_CONTEXT_MESSAGE_LIMIT = 20
-
-internal fun normalizeContextMessageLimit(value: Int): Int =
-    if (value in 1 until MIN_CONTEXT_MESSAGE_LIMIT) MIN_CONTEXT_MESSAGE_LIMIT else value
