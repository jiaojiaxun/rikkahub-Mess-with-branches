<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud-backup + device-transfer rules (API 31+).

   Default: nothing is backed up. We explicitly include only `files/upload/`
   so the user's saved attachments survive a device move; everything else
   stays on-device.

   Why deny-by-default: this app stores LLM-agent state that includes
   credentials we cannot afford to walk off the device. Specifically:
     - LLM provider API keys live in the settings DataStore under
       `datastore/`.

   `<exclude>` is an explicit defence-in-depth even though the cloud-backup
   block is empty (which already excludes-by-default) — anyone editing this
   file later who adds an `<include domain="root" .../>` would otherwise
   silently re-enable backup of these paths.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="upload/" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" path="datastore/" />
    <!-- Pass 3: WebView cookies + localStorage. Auth tokens MUST not walk off the device. -->
    <exclude domain="file" path="browser-profile/" />
    <!-- Phase 22A: on-device LLM weights (1 GB+). Never upload to cloud backup. -->
    <exclude domain="file" path="local-models/" />
    <!-- Jieba FTS dictionary: reproducible from assets, no user data. -->
    <exclude domain="file" path="simple_dict/" />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="upload/" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" path="datastore/" />
    <!-- Pass 3: same reasoning as cloud-backup; never transfer browser auth state. -->
    <exclude domain="file" path="browser-profile/" />
    <!-- Phase 22A: on-device LLM weights. Transferring multi-GB model files on device
         swap causes the transfer to stall or fail silently. User re-downloads on new device. -->
    <exclude domain="file" path="local-models/" />
    <!-- Jieba FTS dictionary: reproducible from assets. -->
    <exclude domain="file" path="simple_dict/" />
  </device-transfer>
</data-extraction-rules>
